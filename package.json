{
  "name": "tvmaze",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:local": "VITE_UI_REMOTE_URL=http://localhost:5001/remoteEntry.js VITE_CATALOG_REMOTE_URL=http://localhost:5002/remoteEntry.js vite --port 5173 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --max-warnings 0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "pinia": "2.3.1",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "1.2.7",
    "@tailwindcss/vite": "4.0.14",
    "@types/node": "22.13.10",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "3.0.8",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.5.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.22.0",
    "eslint-plugin-vue": "10.0.0",
    "jsdom": "26.0.0",
    "prettier": "3.5.3",
    "tailwindcss": "4.0.14",
    "typescript": "5.6.3",
    "vite": "5.4.14",
    "vitest": "3.0.8",
    "vue-tsc": "2.2.8"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.2.4"
  }
}
